<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_profile.xml (fixed - full file) -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
<androidx.core.widget.NestedScrollView
    android:id="@+id/profile_nested_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:background="@color/white">

    <!-- LinearLayout sebagai container utama agar scroll aman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- TOP BAR HEADER (menyerupai header aslinya) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_header_top_bar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@color/white">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Konten utama (mirip isi ConstraintLayout lama) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="80dp">


            <!-- FOTO PROFILE -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_person" />


            <!-- USERNAME -->
            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="username"
                android:textColor="#2E2E2E"
                android:textSize="16sp"
                android:textStyle="normal" />


            <!-- CONTACT -->
            <TextView
                android:id="@+id/tv_user_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="anonymous@gmail.com | +62 xxxxxxxxxx"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <!-- QUICK ACTIONS (3 kolom) -->
            <LinearLayout
                android:id="@+id/quick_actions_layout"
                android:layout_width="241dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- CICILAN -->
                <LinearLayout
                    android:id="@+id/itemCicilan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/cicilan"
                        app:tint="#F7941D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="cicilan"
                        android:textColor="#7A7A7A"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemPengajuanJadwal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/calender_jadwal"
                        app:tint="#F7941D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="jadwal"
                        android:textColor="#7A7A7A"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_riwayat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/riwayat"
                        app:tint="#F7941D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="riwayat"
                        android:textColor="#7A7A7A"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- SECTION TITLES & MENU ITEMS -->
            <TextView
                android:id="@+id/tv_pengaturan_akun_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Pengaturan akun"
                android:textColor="#8A8A8A"
                android:textSize="15sp"
                android:textStyle="normal" />

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#E0E0E0" />

            <!-- ITEM EDIT PROFILE -->
            <LinearLayout
                android:id="@+id/btnEditProfile"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit_profile"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="edit profile"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6E6E6" />
            <!-- ITEM KEAMANAN -->
            <LinearLayout
                android:id="@+id/itemKeamananAkun"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="keamanan akun"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6E6E6" />
            <!-- ITEM NOTIFIKASI -->
            <LinearLayout
                android:id="@+id/itemNotifikasi"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Pengaturan notifikasi"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6E6E6" />
            <!-- ITEM KELUAR AKUN -->
            <LinearLayout
                android:id="@+id/item_keluar_akun"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_logout"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="keluar akun"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6E6E6" />
            <!-- PUSAT BANTUAN -->
            <TextView
                android:id="@+id/tv_pusat_bantuan_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="pusat bantuan"
                android:textColor="#8A8A8A"
                android:textSize="16sp"
                android:textStyle="normal" />

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#E0E0E0" />

            <!-- CUSTOMER SERVICE -->
            <LinearLayout
                android:id="@+id/itemCustomerService"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_customer_service"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="customer service"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6E6E6" />
            <!-- BERI DUKUNGAN -->
            <LinearLayout
                android:id="@+id/item_beri_dukungan"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_support"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="beri dukungan"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6E6E6" />
            <!-- SEPUTAR DHUHHA -->
            <TextView
                android:id="@+id/tv_seputar_dhuhha_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Seputar Drive Nusa"
                android:textColor="#8A8A8A"
                android:textSize="16sp"
                android:textStyle="normal" />

            <View
                android:id="@+id/divider3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#E0E0E0" />

            <!-- KENALI DRIVE NUSA -->
            <LinearLayout
                android:id="@+id/itemKenaliDriveNusa"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/drivenusa"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="kenali Drive nusa"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6E6E6" />
            <!-- SYARAT & KETENTUAN (PASTI TIDAK TERPOTONG) -->
            <LinearLayout
                android:id="@+id/itemSyaratKetentuan"
                style="@style/ProfileMenuItemStyle"
                android:layout_marginBottom="48dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_terms"
                    app:tint="#F7941D" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="syarat dan ketentuan"
                    android:textColor="#7A7A7A"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
    <!-- =================== LOADING OVERLAY =================== -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- BOX LOADING -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_loading_box"
            android:elevation="8dp"
            android:padding="16dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="12sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </FrameLayout>

</FrameLayout>