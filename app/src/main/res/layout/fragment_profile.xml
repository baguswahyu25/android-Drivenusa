<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_profile.xml (fixed - full file) -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_nested_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:background="@color/white">

    <!-- LinearLayout sebagai container utama agar scroll aman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- TOP BAR HEADER (menyerupai header aslinya) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_header_top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/white">

            <TextView
                android:id="@+id/tv_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Konten utama (mirip isi ConstraintLayout lama) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- FOTO PROFILE -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="32dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_person"
                app:civ_border_color="@android:color/darker_gray"
                app:civ_border_width="2dp" />

            <!-- USERNAME -->
            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:text="username"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- CONTACT -->
            <TextView
                android:id="@+id/tv_user_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_gravity="center_horizontal"
                android:text="anonymous@gmail.com | +62 xxxxxxxxxx"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <!-- QUICK ACTIONS (3 kolom) -->
            <LinearLayout
                android:id="@+id/quick_actions_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/btn_chat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/black"
                        android:contentDescription="Chat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="chat"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemPengajuanJadwal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_calender"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pengajuan jadwal"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_riwayat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="riwayat pemesanan"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION TITLES & MENU ITEMS -->
            <TextView
                android:id="@+id/tv_pengaturan_akun_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengaturan akun"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp" />

            <!-- ITEM EDIT PROFILE -->
            <LinearLayout
                android:id="@+id/btnEditProfile"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit_profile"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="edit profile"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <!-- ITEM KEAMANAN -->
            <LinearLayout
                android:id="@+id/itemKeamananAkun"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="keamanan akun"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <!-- ITEM NOTIFIKASI -->
            <LinearLayout
                android:id="@+id/itemNotifikasi"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pengaturan notifikasi"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <!-- ITEM KELUAR AKUN -->
            <LinearLayout
                android:id="@+id/item_keluar_akun"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="keluar akun"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <!-- PUSAT BANTUAN -->
            <TextView
                android:id="@+id/tv_pusat_bantuan_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="pusat bantuan"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp" />

            <!-- CUSTOMER SERVICE -->
            <LinearLayout
                android:id="@+id/itemCustomerService"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_customer_service"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="customer service"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <!-- BERI DUKUNGAN -->
            <LinearLayout
                android:id="@+id/item_beri_dukungan"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_support"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="beri dukungan"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <!-- SEPUTAR DHUHHA -->
            <TextView
                android:id="@+id/tv_seputar_dhuhha_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seputar Drive Nusa"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <View
                android:id="@+id/divider3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp" />

            <!-- KENALI DRIVE NUSA -->
            <LinearLayout
                android:id="@+id/itemKenaliDriveNusa"
                style="@style/ProfileMenuItemStyle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/drivenusa"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="kenali Drive nusa"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

            <!-- SYARAT & KETENTUAN (PASTI TIDAK TERPOTONG) -->
            <LinearLayout
                android:id="@+id/itemSyaratKetentuan"
                style="@style/ProfileMenuItemStyle"
                android:layout_marginBottom="48dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_terms"
                    app:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="syarat dan ketentuan"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
