<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 🔹 BAGIAN HEADER PUTIH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="30dp"
        android:paddingBottom="40dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/logoApp"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/drivenusa"
            android:adjustViewBounds="true"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

    <!-- 🔹 PANEL BAWAH (RECTANGLE DENGAN GRADIENT) -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_form_gradient"
        android:paddingTop="60dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/titleForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lupa Password"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="30dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan email kamu"
            android:inputType="textEmailAddress"
            android:background="@drawable/edittext_white_rounded"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 🔹 Tombol Kirim dengan Efek Ripple -->
        <Button
            android:id="@+id/btnKirimKode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kirim Link Reset"
            android:backgroundTint="#f89331"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="12dp"
            android:foreground="?attr/selectableItemBackground" />

        <!-- 🔹 Tombol Kembali -->
        <TextView
            android:id="@+id/btnKembaliLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="Kembali ke halaman login"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
    <!-- Loading Overlay -->
<FrameLayout
android:id="@+id/loadingOverlay"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#66000000"
android:visibility="gone"
android:clickable="true"
android:focusable="true">

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_loading_box"
    android:gravity="center">

    <ProgressBar
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Memproses..."
        android:textColor="@color/black"
        android:textSize="14sp"/>
</LinearLayout>

</FrameLayout>
</FrameLayout>