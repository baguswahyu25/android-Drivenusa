<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".FormSimActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- HEADER -->
        <RelativeLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back"
                android:layout_centerVertical="true"
                app:tint="@color/black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:text="Formulir Pendaftaran SIM"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <!-- Paket -->
        <TextView
            android:id="@+id/tv_paket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paket: ..."
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Isi Data Diri Anda"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Nama -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Lengkap*"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_nama_lengkap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/background_edit_text"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:padding="10dp"
                android:textColor="@color/black"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <!-- Tempat Lahir -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tempat Lahir*"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/black"/>

                    <EditText
                        android:id="@+id/et_tempat_lahir"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:padding="10dp"
                        android:background="@drawable/background_edit_text"
                        android:inputType="text"
                        android:textColor="@color/black"/>
                </LinearLayout>


                <!-- Spacer kecil -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />


                <!-- Tanggal Lahir -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tanggal Lahir*"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/black"/>

                    <EditText
                        android:id="@+id/et_tanggal_lahir"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:padding="10dp"
                        android:background="@drawable/background_edit_text"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:hint="Pilih tanggal"
                        android:textColorHint="@android:color/darker_gray"
                        android:textColor="@color/black"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Alamat -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alamat Lengkap*"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_alamat"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/background_edit_text"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis Kelamin*"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/et_jenis_kelamin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pilih jenis kelamin"
                    android:inputType="none"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Pekerjaan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pekerjaan*"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_pekerjaan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/background_edit_text"
                android:inputType="text"
                android:minHeight="48dp"
                android:padding="10dp"
                android:textColor="@color/black"/>

            <!-- Pilih Mobil -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Mobil*"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rg_pilih_mobil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_avanza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toyota Avanza"/>

                <RadioButton
                    android:id="@+id/rb_ayla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daihatsu Ayla"/>

                <RadioButton
                    android:id="@+id/rb_calya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toyota Calya"/>

                <RadioButton
                    android:id="@+id/rb_brio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honda Brio"/>

                <RadioButton
                    android:id="@+id/rb_mobilio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honda Mobilio"/>
            </RadioGroup>

            <!-- Metode Pembayaran -->
            <TextView
                android:id="@+id/tv_title_metode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Metode Pembayaran"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/rg_metode_pembayaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_transfer_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transfer Bank"/>

                <RadioButton
                    android:id="@+id/rb_kredit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kredit"/>

                <RadioButton
                    android:id="@+id/rb_tunai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tunai"
                    android:layout_marginBottom="24dp"/>
            </RadioGroup>

            <!-- Opsi Kredit -->
            <LinearLayout
                android:id="@+id/ll_opsi_kredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Kredit"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <RadioGroup
                    android:id="@+id/rg_opsi_kredit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rb_kredit_minggu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Per Minggu"/>

                    <RadioButton
                        android:id="@+id/rb_kredit_bulan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Per Bulan"/>

                    <RadioButton
                        android:id="@+id/rb_kredit_tahun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Per Tahun"/>
                </RadioGroup>
            </LinearLayout>
            <!-- Upload Pas Photo 3x4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="1. Upload Pas Photo 3x4 *"
                android:textColor="@color/black"/>

            <LinearLayout
                android:id="@+id/btnUploadPasPhoto"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:background="@drawable/upload_box">

                <!-- KOTAK PILIH FILE (FULL ATAS BAWAH KIRI) -->
                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/upload_box_inner"
                    android:gravity="center">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Pilih file"
                        android:textColor="#555"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- ⬅️ INI YANG MENAMPILKAN NAMA FILE -->
                <TextView
                    android:id="@+id/txtPasPhoto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Belum ada file dipilih"
                    android:textColor="@color/black"
                    android:singleLine="true"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Upload KTP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="2. Upload KTP *"
                android:textColor="@color/black"/>

            <LinearLayout
                android:id="@+id/btnUploadKtp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:background="@drawable/upload_box">

                <!-- KOTAK PILIH FILE (FULL ATAS BAWAH KIRI) -->
                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/upload_box_inner"
                    android:gravity="center">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Pilih file"
                        android:textColor="#555"
                        android:textSize="14sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/txtKtpName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Belum ada file dipilih"
                    android:textColor="@color/black"
                    android:singleLine="true"
                    android:ellipsize="end"/>

            </LinearLayout>

            <!-- TextView KIR kesehatan + psikologi -->
            <TextView
                android:id="@+id/tv_kir_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="3. KIR Kesehatan + Psikologi (tanggungan siswa)"
                android:textColor="@color/black"
                android:textSize="14sp" />

                <!-- Konfirmasi -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. Konfirmasi dan Review"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"/>

                <CheckBox
                    android:id="@+id/cb_konfirmasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pastikan data diri anda sudah terisi dengan benar"
                    android:textColor="@color/black"
                    android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:visibility="gone"
                    android:indeterminate="true" />

                <Button
                    android:id="@+id/btnSimpan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="Simpan" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
