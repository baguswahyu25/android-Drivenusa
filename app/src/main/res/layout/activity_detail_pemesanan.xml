<?xml version="1.0" encoding="utf-8"?>
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ===========================
                 HEADER + BACK + LOTTIE
            ============================ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/bg_detail_header">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_back"
                    android:padding="10dp"
                    android:elevation="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/successAnim"
                    android:layout_marginStart="16dp"/>

                <!-- Title -->
                <TextView
                    android:id="@+id/titleDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="detail pemesanan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/successAnim"/>

                <!-- Lottie -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/successAnim"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:lottie_loop="false"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ===========================
                 KARTU MOBIL
            ============================ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-30dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/imgMobil"
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/rounded_white"
                        android:padding="5dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:id="@+id/tvJudul"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kursus mengemudi"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#000000"/>

                        <TextView
                            android:id="@+id/tvPaket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="paket manual"
                            android:textSize="14sp"
                            android:textColor="#777777"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/tvHarga"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#2D6EFF"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- ===========================
                 DETAIL PEMBAYARAN
            ============================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. detail pembayaran"
                    android:textColor="#000"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvNamaPengirim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nama pengirim : alexander"
                    android:textColor="#333"
                    android:textSize="15sp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvNamaPenerima"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nama penerima : dhuha group"
                    android:textSize="15sp"
                    android:textColor="#333"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvTanggalBayar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="tanggal bayar : 13:00, 12-09-2025"
                    android:textSize="15sp"
                    android:textColor="#333"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvMetodeBayar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="metode pembayaran : transfer bank"
                    android:textSize="15sp"
                    android:textColor="#333"
                    android:layout_marginTop="4dp"/>


                <!-- GARIS PEMBATAS -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="16dp"/>


                <!-- ===========================
                     DOKUMEN PENDUKUNG
                ============================ -->


                <!-- ===========================
                     STATUS PEMESANAN
                ============================ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Status pemesanan"
                    android:textColor="#000"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginTop="18dp"/>

                <LinearLayout
                    android:id="@+id/layoutStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_status_pending">

                    <ImageView
                        android:id="@+id/imgStatus"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:tint="#FFFFFF"
                        android:src="@drawable/ic_pending"/>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PENDING"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>




                <!-- ===========================
                     BUTTONS
                ============================ -->

                <!-- Button 2 (Blue Gradient) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeranda"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="kembali ke beranda"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="180dp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#0B5694"
                    android:backgroundTint="@null" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
