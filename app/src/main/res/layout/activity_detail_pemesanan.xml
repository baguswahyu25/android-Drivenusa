<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ===========================
             HEADER + BACK + LOTTIE
        ============================ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_detail_header">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_back_circle"
                android:padding="10dp"
                android:background="@drawable/rounded_white"
                android:elevation="6dp"/>

            <!-- Title -->
            <TextView
                android:id="@+id/titleDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="detail pemesanan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"/>

            <!-- Lottie Animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/successAnim"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="10dp"
                app:lottie_rawRes="@raw/succes_lotties"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"/>

        </RelativeLayout>


        <!-- ===========================
             KARTU MOBIL
        ============================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgMobil"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_white"
                    android:padding="5dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp">

                    <TextView
                        android:id="@+id/tvJudul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kursus mengemudi"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="#000000"/>

                    <TextView
                        android:id="@+id/tvPaket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="paket manual"
                        android:textSize="14sp"
                        android:textColor="#777777"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tvHarga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 150.000"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="#2D6EFF"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- ===========================
             DETAIL PEMBAYARAN
        ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. detail pembayaran"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/tvNamaPengirim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nama pengirim : alexander"
                android:textColor="#333"
                android:textSize="15sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvNamaPenerima"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nama penerima : dhuha group"
                android:textSize="15sp"
                android:textColor="#333"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvTanggalBayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tanggal bayar : 13:00, 12-09-2025"
                android:textSize="15sp"
                android:textColor="#333"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvMetodeBayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="metode pembayaran : transfer bank"
                android:textSize="15sp"
                android:textColor="#333"
                android:layout_marginTop="4dp"/>


            <!-- GARIS PEMBATAS -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"/>


            <!-- ===========================
                 DOKUMEN PENDUKUNG
            ============================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. dokumen pendukung"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"/>

                <TextView
                    android:id="@+id/tvFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File : screenshot_bukti.transfer"
                    android:textColor="#333"
                    android:textSize="15sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>


            <!-- ===========================
                 STATUS PEMESANAN
            ============================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Status pemesanan"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginTop="18dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berhasil"
                    android:textColor="#009944"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>


            <!-- ===========================
                 BUTTONS
            ============================ -->

            <!-- Button 1 (White Border Blue) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPengajuan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="lihat pengajuan kursus"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:textColor="#2D6EFF"
                android:background="@drawable/btn_white_border"
                android:backgroundTint="@null" />



            <!-- Button 2 (Blue Gradient) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBeranda"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="kembali ke beranda"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_blue_solid"
                android:backgroundTint="@null" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
