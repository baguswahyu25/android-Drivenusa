<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="pengaturan notifikasi"
                android:textStyle="bold"
                android:textColor="#000"
                android:textSize="16sp" />

        </RelativeLayout>

        <!-- TITLE GROUP 1 -->
        <TextView
            android:id="@+id/labelNotifAplikasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifikasi Aplikasi"
            android:textStyle="bold"
            android:textColor="#000"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:textSize="14sp" />

        <!-- Item: Pengingat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titlePengingat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pengingat"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/descPengingat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mengingatkan anda untuk melakukan pengajuan\njadwal kurus mengemudi"
                    android:textSize="12sp"
                    android:textColor="#555" />

            </LinearLayout>

            <Switch
                android:id="@+id/switchPengingat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- Item: Pembaruan Aplikasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/titlePembaruanAplikasi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="pembaruan aplikasi"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchPembaruanAplikasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="#EEEEEE" />

        <!-- TITLE GROUP 2 -->
        <TextView
            android:id="@+id/labelNotifEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifikasi Email"
            android:textStyle="bold"
            android:textColor="#000"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:textSize="14sp" />

        <!-- Item: Pembaruan Produk -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/titlePembaruanProduk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="pembaruan produk"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchPembaruanProduk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- Item: Promo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/titlePromo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="promo"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchPromo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
