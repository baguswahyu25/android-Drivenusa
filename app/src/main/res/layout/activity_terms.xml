<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 🔷 HEADER ATAS SESUAI PERMINTAAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#000f3f"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="20dp"
        android:elevation="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Syarat &amp; Ketentuan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <!-- 🔻 SCROLLVIEW TETAP ASLI, TIDAK DIUBAH SEBIJI PUN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Syarat &amp; Ketentuan Penggunaan"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000f3f"
                android:layout_marginBottom="18dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Penerimaan Ketentuan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000f3f"/>

            <View android:layout_width="50dp" android:layout_height="3dp"
                android:background="#f89331"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dengan menggunakan aplikasi Drive Nusa, pengguna dianggap setuju untuk terikat pada seluruh Syarat &amp; Ketentuan ini tanpa pengecualian. Jika pengguna tidak menyetujui, maka disarankan untuk tidak melanjutkan penggunaan layanan."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Penggunaan Layanan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000f3f"/>

            <View android:layout_width="50dp" android:layout_height="3dp"
                android:background="#f89331"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengguna bertanggung jawab penuh terhadap aktivitas pada akun yang terdaftar. Dilarang keras menggunakan aplikasi untuk aktivitas ilegal, manipulasi data, atau tindakan lain yang merugikan pihak lain dan sistem."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Privasi &amp; Pengelolaan Data"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000f3f"/>

            <View android:layout_width="50dp" android:layout_height="3dp"
                android:background="#f89331"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data pribadi pengguna digunakan untuk kebutuhan autentikasi, peningkatan kualitas layanan, serta keamanan sistem. Drive Nusa tidak akan membagikan informasi pribadi kepada pihak ketiga kecuali diwajibkan oleh hukum atau atas izin pengguna."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Hak &amp; Kewajiban Pengguna"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000f3f"/>

            <View android:layout_width="50dp" android:layout_height="3dp"
                android:background="#f89331"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Menggunakan layanan secara sah dan sesuai aturan.\n• Menjaga kerahasiaan akun dan kata sandi.\n• Melaporkan jika terjadi pelanggaran atau aktivitas mencurigakan.\n• Tidak menyalahgunakan fitur demi keuntungan pribadi yang merugikan sistem."
                android:textSize="15sp"
                android:textColor="#333333"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Perubahan Kebijakan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000f3f"/>

            <View android:layout_width="50dp" android:layout_height="3dp"
                android:background="#f89331"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Drive Nusa berhak melakukan pembaruan pada isi Syarat &amp; Ketentuan tanpa pemberitahuan sebelumnya. Pengguna diimbau untuk memeriksa halaman ini secara berkala demi mengetahui aturan terbaru yang diberlakukan."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Penutup"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000f3f"/>

            <View android:layout_width="50dp" android:layout_height="3dp"
                android:background="#f89331"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dengan tetap menggunakan aplikasi ini berarti pengguna telah membaca, memahami, dan menyetujui seluruh isi Syarat &amp; Ketentuan. Terima kasih telah memilih layanan kami."
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
